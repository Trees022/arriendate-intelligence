# API runtime. SQLite is a local-only fallback when Docker/Supabase CLI is unavailable.
ARRIENDATE_DATABASE_URL=sqlite+aiosqlite:///./.local/arriendate.db
# Production/Supabase example:
# ARRIENDATE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
ARRIENDATE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ARRIENDATE_LOG_LEVEL=INFO
ARRIENDATE_SEED_DEMO_DATA=true

# Browser-safe values only. Never put database or AI secrets in VITE_* variables.
VITE_API_URL=http://127.0.0.1:8000/api

# Reserved for the next AI milestone.
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=text-embedding-3-small
